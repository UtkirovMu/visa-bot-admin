# MAJBURIY — bot (visabot) bilan bir xil token. Admin kirishini tekshirish va xabar yuborish uchun.
BOT_TOKEN=

# MAJBURIY — admin Telegram chat ID'lari (vergul bilan)
ADMIN_IDS=1830068413

# MAJBURIY — ma'lumotlarni shifrlash kaliti (64 belgili hex). Yaratish:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# DIQQAT: kalit yo'qolsa, bazadagi ma'lumotlarni ochib bo'lmaydi. Xavfsiz joyda zaxira saqlang.
DATA_KEY=

# Baza fayli (Railway volume /data ga ulanadi)
DB_PATH=/data/visa-admin.db

# Tekshiruv vaqtlari (Toshkent vaqti)
CHECK_TIMES=09:00,14:00,20:00

# Ixtiyoriy
# TZ_OFFSET_MINUTES=300
# CHECK_DELAY_MS=5000
# TRUST_PROXY=true
